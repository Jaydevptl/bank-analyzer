diff --git a/backend/supabase_migrate_accounts_ledger.sql b/backend/supabase_migrate_accounts_ledger.sql
new file mode 100644
index 0000000..5d058f3
--- /dev/null
+++ b/backend/supabase_migrate_accounts_ledger.sql
@@ -0,0 +1,57 @@
+-- ============================================================================
+-- Migration: Accounts, Report Type, Ledger Support
+-- Run this in Supabase SQL Editor AFTER supabase_migrate_trades.sql
+-- ============================================================================
+
+-- 1. Add account_name and report_type to trades table
+ALTER TABLE trades
+  ADD COLUMN IF NOT EXISTS account_name TEXT DEFAULT '',
+  ADD COLUMN IF NOT EXISTS report_type TEXT DEFAULT 'Trades'
+    CHECK (report_type IN ('Trades', 'PnL', 'Ledger'));
+
+CREATE INDEX IF NOT EXISTS idx_trades_account_name ON trades(account_name);
+CREATE INDEX IF NOT EXISTS idx_trades_report_type ON trades(report_type);
+
+-- 2. Add file_hash to trade_upload_reports for duplicate detection
+ALTER TABLE trade_upload_reports
+  ADD COLUMN IF NOT EXISTS file_hashes JSONB DEFAULT '[]'::jsonb;
+
+-- 3. Stock Accounts master table
+CREATE TABLE IF NOT EXISTS stock_accounts (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  account_name TEXT NOT NULL,
+  broker TEXT DEFAULT '',
+  account_holder TEXT DEFAULT '',
+  account_id TEXT DEFAULT '',
+  notes TEXT DEFAULT '',
+  is_active BOOLEAN DEFAULT TRUE,
+  created_at TIMESTAMPTZ DEFAULT NOW(),
+  updated_at TIMESTAMPTZ DEFAULT NOW()
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS idx_stock_accounts_name ON stock_accounts(account_name);
+
+-- 4. Ledger Entries table
+CREATE TABLE IF NOT EXISTS ledger_entries (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  entry_date TIMESTAMPTZ NOT NULL,
+  account_name TEXT DEFAULT '',
+  broker TEXT DEFAULT '',
+  account_id TEXT DEFAULT '',
+  entry_type TEXT DEFAULT 'Other'
+    CHECK (entry_type IN ('Deposit', 'Withdrawal', 'Dividend', 'Charges', 'Tax', 'Interest', 'Other')),
+  description TEXT DEFAULT '',
+  amount NUMERIC DEFAULT 0,
+  balance NUMERIC DEFAULT 0,
+  upload_id TEXT DEFAULT '',
+  source_file TEXT DEFAULT '',
+  raw_data JSONB DEFAULT '{}'::jsonb,
+  created_at TIMESTAMPTZ DEFAULT NOW(),
+  updated_at TIMESTAMPTZ DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS idx_ledger_date ON ledger_entries(entry_date);
+CREATE INDEX IF NOT EXISTS idx_ledger_account ON ledger_entries(account_name);
+CREATE INDEX IF NOT EXISTS idx_ledger_broker ON ledger_entries(broker);
+CREATE INDEX IF NOT EXISTS idx_ledger_type ON ledger_entries(entry_type);
+CREATE INDEX IF NOT EXISTS idx_ledger_upload ON ledger_entries(upload_id);
diff --git a/frontend/src/components/ShareMarket/AccountsPage.jsx b/frontend/src/components/ShareMarket/AccountsPage.jsx
new file mode 100644
index 0000000..8732191
--- /dev/null
+++ b/frontend/src/components/ShareMarket/AccountsPage.jsx
@@ -0,0 +1,141 @@
+import React, { useState, useEffect } from 'react';
+import { TrendingUp, TrendingDown, Wallet, BarChart2, RefreshCw } from 'lucide-react';
+import { getAccountSummary } from '../../services/api';
+
+const fmt = (n) => new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n || 0);
+const fmtCompact = (n) => {
+  const abs = Math.abs(n);
+  if (abs >= 1e7) return `${(n / 1e7).toFixed(2)}Cr`;
+  if (abs >= 1e5) return `${(n / 1e5).toFixed(2)}L`;
+  if (abs >= 1e3) return `${(n / 1e3).toFixed(1)}K`;
+  return fmt(n);
+};
+
+function PnLBadge({ value }) {
+  const isPos = value >= 0;
+  return (
+    <span style={{
+      display: 'inline-flex', alignItems: 'center', gap: 4,
+      padding: '2px 8px', borderRadius: 6,
+      fontSize: 12, fontWeight: 700,
+      background: isPos ? 'rgba(34,197,94,0.1)' : 'rgba(239,68,68,0.1)',
+      color: isPos ? 'var(--success)' : 'var(--danger)',
+    }}>
+      {isPos ? <TrendingUp size={11} /> : <TrendingDown size={11} />}
+      {isPos ? '+' : ''}₹{fmtCompact(value)}
+    </span>
+  );
+}
+
+export default function AccountsPage() {
+  const [data, setData] = useState(null);
+  const [loading, setLoading] = useState(true);
+
+  const load = async () => {
+    setLoading(true);
+    try {
+      const res = await getAccountSummary();
+      setData(res.data);
+    } catch {}
+    setLoading(false);
+  };
+
+  useEffect(() => { load(); }, []);
+
+  if (loading) return (
+    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', height: 200, gap: 8, color: 'var(--text-muted)' }}>
+      <RefreshCw size={16} style={{ animation: 'spin 1s linear infinite' }} /> Loading accounts...
+    </div>
+  );
+
+  if (!data || !data.accounts?.length) return (
+    <div style={{ textAlign: 'center', padding: 60, color: 'var(--text-muted)' }}>
+      <Wallet size={40} style={{ marginBottom: 12, opacity: 0.3 }} />
+      <p>No account data yet. Upload broker statements to get started.</p>
+    </div>
+  );
+
+  const { accounts, overall } = data;
+  const totalPnL = overall.totalRealizedPnL;
+
+  return (
+    <div className="animate-fade-in">
+      {/* Overall Summary */}
+      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(5, 1fr)', gap: 12, marginBottom: 24 }}>
+        {[
+          { label: 'Total Realized P&L', value: `${totalPnL >= 0 ? '+' : ''}₹${fmtCompact(totalPnL)}`, color: totalPnL >= 0 ? 'var(--success)' : 'var(--danger)', border: totalPnL >= 0 ? 'var(--success)' : 'var(--danger)' },
+          { label: 'Total Invested', value: `₹${fmtCompact(overall.totalInvested)}`, color: 'var(--info)', border: 'var(--info)' },
+          { label: 'Holdings', value: overall.totalHoldings, color: 'var(--warning)', border: 'var(--warning)' },
+          { label: 'Total Charges', value: `₹${fmtCompact(overall.totalCharges)}`, color: 'var(--danger)', border: 'var(--danger)' },
+          { label: 'Total Trades', value: overall.totalTrades, color: 'var(--text-primary)', border: 'var(--accent)' },
+        ].map(({ label, value, color, border }) => (
+          <div key={label} className="card" style={{ padding: '16px 18px', borderLeft: `4px solid ${border}` }}>
+            <div style={{ fontSize: 18, fontWeight: 800, color, marginBottom: 4 }}>{value}</div>
+            <div style={{ fontSize: 10, color: 'var(--text-muted)', textTransform: 'uppercase', letterSpacing: '0.06em', fontWeight: 600 }}>{label}</div>
+          </div>
+        ))}
+      </div>
+
+      {/* Account Cards */}
+      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(340px, 1fr))', gap: 16 }}>
+        {accounts.map(acc => {
+          const pnl = acc.totalRealizedPnL;
+          const isProfit = pnl >= 0;
+          return (
+            <div key={acc.accountName} className="card" style={{ padding: 20, borderTop: `3px solid ${isProfit ? 'var(--success)' : 'var(--danger)'}` }}>
+              {/* Account Header */}
+              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 14 }}>
+                <div>
+                  <div style={{ fontSize: 14, fontWeight: 700, color: 'var(--text-primary)', marginBottom: 4 }}>{acc.accountName}</div>
+                  <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
+                    {acc.brokers.map(b => (
+                      <span key={b} className="badge badge-info" style={{ fontSize: 10 }}>{b}</span>
+                    ))}
+                  </div>
+                </div>
+                <PnLBadge value={pnl} />
+              </div>
+
+              {/* Stats Grid */}
+              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 10 }}>
+                {[
+                  { label: 'Invested', value: `₹${fmtCompact(acc.totalInvested)}`, color: 'var(--info)' },
+                  { label: 'Holdings', value: acc.holdingsCount + ' symbols', color: 'var(--warning)' },
+                  { label: 'Total Trades', value: acc.totalTrades, color: 'var(--text-secondary)' },
+                  { label: 'Charges', value: `₹${fmtCompact(acc.totalCharges)}`, color: 'var(--danger)' },
+                ].map(({ label, value, color }) => (
+                  <div key={label} style={{ background: 'var(--bg-page)', borderRadius: 8, padding: '10px 12px' }}>
+                    <div style={{ fontSize: 13, fontWeight: 700, color, marginBottom: 2 }}>{value}</div>
+                    <div style={{ fontSize: 10, color: 'var(--text-muted)', fontWeight: 600, textTransform: 'uppercase', letterSpacing: '0.05em' }}>{label}</div>
+                  </div>
+                ))}
+              </div>
+
+              {/* Top Symbols */}
+              {acc.topSymbols?.length > 0 && (
+                <div style={{ marginTop: 14, paddingTop: 14, borderTop: '1px solid var(--border-light)' }}>
+                  <div style={{ fontSize: 10, fontWeight: 600, color: 'var(--text-muted)', textTransform: 'uppercase', marginBottom: 8 }}>Top P&L Symbols</div>
+                  <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
+                    {acc.topSymbols.map(s => (
+                      <span key={s.symbol} style={{
+                        fontSize: 11, padding: '3px 8px', borderRadius: 6, fontWeight: 600,
+                        background: s.pnl >= 0 ? 'rgba(34,197,94,0.1)' : 'rgba(239,68,68,0.1)',
+                        color: s.pnl >= 0 ? 'var(--success)' : 'var(--danger)',
+                      }}>
+                        {s.symbol} {s.pnl >= 0 ? '+' : ''}₹{fmtCompact(s.pnl)}
+                      </span>
+                    ))}
+                  </div>
+                </div>
+              )}
+            </div>
+          );
+        })}
+      </div>
+
+      <button className="btn btn-ghost btn-sm" onClick={load} style={{ marginTop: 16, gap: 6 }}>
+        <RefreshCw size={13} /> Refresh
+      </button>
+    </div>
+  );
+}
diff --git a/frontend/src/components/ShareMarket/LedgerPage.jsx b/frontend/src/components/ShareMarket/LedgerPage.jsx
new file mode 100644
index 0000000..4d8cb7d
--- /dev/null
+++ b/frontend/src/components/ShareMarket/LedgerPage.jsx
@@ -0,0 +1,170 @@
+import React, { useState, useEffect } from 'react';
+import { BookOpen, RefreshCw, TrendingUp, TrendingDown, ArrowUpCircle, ArrowDownCircle } from 'lucide-react';
+import { getLedger, getStockAccounts } from '../../services/api';
+
+const fmt = (n) => new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n || 0);
+const formatDate = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';
+
+const TYPE_COLORS = {
+  Deposit: { bg: 'rgba(34,197,94,0.1)', color: 'var(--success)' },
+  Withdrawal: { bg: 'rgba(239,68,68,0.1)', color: 'var(--danger)' },
+  Dividend: { bg: 'rgba(59,130,246,0.1)', color: 'var(--info)' },
+  Charges: { bg: 'rgba(245,158,11,0.1)', color: 'var(--warning)' },
+  Tax: { bg: 'rgba(139,92,246,0.1)', color: '#8B5CF6' },
+  Interest: { bg: 'rgba(20,184,166,0.1)', color: '#14B8A6' },
+  Other: { bg: 'rgba(100,116,139,0.1)', color: 'var(--text-muted)' },
+};
+
+const ENTRY_TYPES = ['all', 'Deposit', 'Withdrawal', 'Dividend', 'Charges', 'Tax', 'Interest', 'Other'];
+
+export default function LedgerPage() {
+  const [entries, setEntries] = useState([]);
+  const [summary, setSummary] = useState({});
+  const [accounts, setAccounts] = useState([]);
+  const [loading, setLoading] = useState(true);
+  const [filters, setFilters] = useState({ accountName: 'all', entryType: 'all', startDate: '', endDate: '' });
+  const [page, setPage] = useState(1);
+  const [pagination, setPagination] = useState({ total: 0, pages: 1 });
+
+  const load = async (pg = 1) => {
+    setLoading(true);
+    try {
+      const params = { ...filters, page: pg, limit: 100 };
+      const [ledRes, accRes] = await Promise.all([
+        getLedger(params),
+        getStockAccounts(),
+      ]);
+      setEntries(ledRes.data?.entries || []);
+      setSummary(ledRes.data?.summary || {});
+      setPagination(ledRes.data?.pagination || { total: 0, pages: 1 });
+      setAccounts(accRes.data?.accounts || []);
+    } catch {}
+    setLoading(false);
+  };
+
+  useEffect(() => { setPage(1); load(1); }, [filters]);
+
+  const handleFilter = (key, val) => setFilters(f => ({ ...f, [key]: val }));
+
+  if (!loading && !entries.length && filters.accountName === 'all' && !filters.entryType && !filters.startDate) {
+    return (
+      <div style={{ textAlign: 'center', padding: 60, color: 'var(--text-muted)' }}>
+        <BookOpen size={40} style={{ marginBottom: 12, opacity: 0.3 }} />
+        <p style={{ marginBottom: 8 }}>No ledger entries yet.</p>
+        <p style={{ fontSize: 12 }}>Upload a Ledger Report in the Upload section to see fund movements.</p>
+      </div>
+    );
+  }
+
+  return (
+    <div className="animate-fade-in">
+      {/* Summary Cards */}
+      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(5, 1fr)', gap: 12, marginBottom: 20 }}>
+        {[
+          { label: 'Total Deposits', value: `₹${fmt(summary.totalDeposits)}`, color: 'var(--success)', border: 'var(--success)' },
+          { label: 'Total Withdrawals', value: `₹${fmt(summary.totalWithdrawals)}`, color: 'var(--danger)', border: 'var(--danger)' },
+          { label: 'Dividends', value: `₹${fmt(summary.totalDividends)}`, color: 'var(--info)', border: 'var(--info)' },
+          { label: 'Charges', value: `₹${fmt(summary.totalCharges)}`, color: 'var(--warning)', border: 'var(--warning)' },
+          { label: 'Tax', value: `₹${fmt(summary.totalTax)}`, color: '#8B5CF6', border: '#8B5CF6' },
+        ].map(({ label, value, color, border }) => (
+          <div key={label} className="card" style={{ padding: '14px 16px', borderLeft: `4px solid ${border}` }}>
+            <div style={{ fontSize: 15, fontWeight: 800, color, marginBottom: 2 }}>{value}</div>
+            <div style={{ fontSize: 10, color: 'var(--text-muted)', textTransform: 'uppercase', letterSpacing: '0.06em', fontWeight: 600 }}>{label}</div>
+          </div>
+        ))}
+      </div>
+
+      {/* Filters */}
+      <div className="card" style={{ padding: '12px 16px', marginBottom: 16, display: 'flex', gap: 12, flexWrap: 'wrap', alignItems: 'center' }}>
+        <select value={filters.accountName} onChange={e => handleFilter('accountName', e.target.value)}
+          style={{ padding: '6px 10px', fontSize: 12, border: '1px solid var(--border)', borderRadius: 'var(--radius)', background: 'var(--bg-card)', color: 'var(--text-primary)' }}>
+          <option value="all">All Accounts</option>
+          {accounts.map(a => <option key={a.account_name} value={a.account_name}>{a.account_name}</option>)}
+        </select>
+
+        <select value={filters.entryType} onChange={e => handleFilter('entryType', e.target.value)}
+          style={{ padding: '6px 10px', fontSize: 12, border: '1px solid var(--border)', borderRadius: 'var(--radius)', background: 'var(--bg-card)', color: 'var(--text-primary)' }}>
+          {ENTRY_TYPES.map(t => <option key={t} value={t}>{t === 'all' ? 'All Types' : t}</option>)}
+        </select>
+
+        <input type="date" value={filters.startDate} onChange={e => handleFilter('startDate', e.target.value)}
+          style={{ padding: '6px 10px', fontSize: 12, border: '1px solid var(--border)', borderRadius: 'var(--radius)', background: 'var(--bg-card)', color: 'var(--text-primary)' }} />
+        <input type="date" value={filters.endDate} onChange={e => handleFilter('endDate', e.target.value)}
+          style={{ padding: '6px 10px', fontSize: 12, border: '1px solid var(--border)', borderRadius: 'var(--radius)', background: 'var(--bg-card)', color: 'var(--text-primary)' }} />
+
+        <button className="btn btn-ghost btn-xs" onClick={() => setFilters({ accountName: 'all', entryType: 'all', startDate: '', endDate: '' })}>
+          Clear
+        </button>
+
+        <span style={{ marginLeft: 'auto', fontSize: 11, color: 'var(--text-muted)' }}>
+          {pagination.total} entries
+        </span>
+
+        <button className="btn btn-ghost btn-xs" onClick={() => load(page)} style={{ gap: 4 }}>
+          <RefreshCw size={12} /> Refresh
+        </button>
+      </div>
+
+      {/* Table */}
+      <div className="card" style={{ padding: 0 }}>
+        {loading ? (
+          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', height: 120, gap: 8, color: 'var(--text-muted)' }}>
+            <RefreshCw size={14} style={{ animation: 'spin 1s linear infinite' }} /> Loading...
+          </div>
+        ) : (
+          <div className="table-wrapper">
+            <table>
+              <thead>
+                <tr>
+                  <th>Date</th>
+                  <th>Account</th>
+                  <th>Type</th>
+                  <th>Description</th>
+                  <th style={{ textAlign: 'right' }}>Amount</th>
+                  <th style={{ textAlign: 'right' }}>Balance</th>
+                </tr>
+              </thead>
+              <tbody>
+                {entries.length === 0 ? (
+                  <tr><td colSpan={6} style={{ textAlign: 'center', color: 'var(--text-muted)', padding: 32 }}>No entries match the filters.</td></tr>
+                ) : entries.map(e => {
+                  const tc = TYPE_COLORS[e.entry_type] || TYPE_COLORS.Other;
+                  const isCredit = ['Deposit', 'Dividend', 'Interest'].includes(e.entry_type);
+                  return (
+                    <tr key={e.id}>
+                      <td style={{ fontSize: 12, whiteSpace: 'nowrap' }}>{formatDate(e.entry_date)}</td>
+                      <td style={{ fontSize: 11 }}>{e.account_name || '-'}</td>
+                      <td>
+                        <span style={{ fontSize: 11, padding: '2px 8px', borderRadius: 6, fontWeight: 600, background: tc.bg, color: tc.color }}>
+                          {e.entry_type}
+                        </span>
+                      </td>
+                      <td style={{ fontSize: 11, maxWidth: 300, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
+                        {e.description || '-'}
+                      </td>
+                      <td style={{ textAlign: 'right', fontWeight: 700, color: isCredit ? 'var(--success)' : 'var(--danger)', fontSize: 12 }}>
+                        {isCredit ? '+' : '-'}₹{fmt(Math.abs(e.amount))}
+                      </td>
+                      <td style={{ textAlign: 'right', fontSize: 12 }}>
+                        {e.balance ? `₹${fmt(e.balance)}` : '-'}
+                      </td>
+                    </tr>
+                  );
+                })}
+              </tbody>
+            </table>
+          </div>
+        )}
+      </div>
+
+      {/* Pagination */}
+      {pagination.pages > 1 && (
+        <div style={{ display: 'flex', justifyContent: 'center', gap: 8, marginTop: 16 }}>
+          <button className="btn btn-ghost btn-sm" disabled={page <= 1} onClick={() => { setPage(p => p - 1); load(page - 1); }}>Prev</button>
+          <span style={{ fontSize: 12, color: 'var(--text-muted)', alignSelf: 'center' }}>Page {page} / {pagination.pages}</span>
+          <button className="btn btn-ghost btn-sm" disabled={page >= pagination.pages} onClick={() => { setPage(p => p + 1); load(page + 1); }}>Next</button>
+        </div>
+      )}
+    </div>
